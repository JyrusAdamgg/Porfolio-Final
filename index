<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Anton&family=Oswald:wght@200..700&display=swap" rel="stylesheet">
    
    <style>

        *, *::before, *::after {
            box-sizing: border-box;
        }

        body {
            background-color: antiquewhite;
            margin: 0;
            padding: 0;
        }

        .image {
            background-image: url("until.png");
            background-size: cover;
            background-repeat: no-repeat;
            background-position: center;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            transition: background-size 0.3s ease;
        }

        .top {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            justify-content: center;
            padding: 16px 20px;
            background: rgba(0,0,0,0.25);
        }

        .top a {
            background-color: transparent;
            font-family: "Oswald", sans-serif;
            border: none;
            cursor: pointer;
            font-size: clamp(14px, 2vw, 22px);
            transition: 0.2s;
            color: whitesmoke;
            text-decoration: none;
            padding: 4px 8px;
        }

        .top a:hover {
            color: brown;
            transform: scale(1.1);
        }

        .portfolio {
            font-family: "Anton", sans-serif;
            font-size: clamp(60px, 13vw, 180px);
            text-align: center;
            line-height: 0.9;
            -webkit-text-stroke: 3px brown;
            color: peachpuff;
            cursor: default;
            padding: 0 16px 40px;
            margin: 0;
        }

        .portfolio p {
            margin: 0;
            transition: 0.2s;
        }

        .portfolio p:hover {
            color: brown;
            transform: scale(1.02);
        }

        .space {
            padding: 30px 20px;
            max-width: 1100px;
            margin: 0 auto;
        }

        .title {
            font-size: clamp(48px, 10vw, 150px);
            font-family: "Oswald", sans-serif;
            font-weight: bold;
            margin: 0 0 20px 0;
            transition: 0.2s;
            cursor: default;
            display: block;
            color: gray;
        }

        .title:hover {
            color: brown;
            transform: scale(1.02);
        }

        #about {
            padding: 40px 20px;
        }

        #about > .space > .title {
            margin-left: 0;
        }

        .about-container {
            display: flex;
            flex-direction: row;
            justify-content: space-between;
            align-items: flex-start;
            gap: 30px;
            flex-wrap: wrap;
        }

        .paragraph {
            flex: 1;
            min-width: 220px;
        }

        .paragraph span {
            font-size: clamp(16px, 2vw, 24px);
            font-family: "Oswald", sans-serif;
            display: block;
            margin-bottom: 6px;
        }

        .logo {
            width: clamp(200px, 35vw, 420px);
            height: auto;
            border: 3px solid white;
            border-radius: 15px;
            transition: 0.3s ease;
            flex-shrink: 0;
        }

        .logo:hover {
            transform: scale(1.03);
        }

        .bio {
            font-size: clamp(14px, 1.6vw, 20px);
            font-family: "Oswald", sans-serif;
            margin-top: 20px;
        }

        .skills-list {
            font-family: "Oswald", sans-serif;
            font-size: clamp(14px, 1.6vw, 18px);
        }

        .quiz-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
            gap: 16px;
            margin-top: 8px;
        }

        .quiz-card {
            background: rgba(255,255,255,0.55);
            border: 2px solid gray;
            border-radius: 10px;
            padding: 18px 20px;
            font-family: "Oswald", sans-serif;
            transition: 0.2s;
        }

        .quiz-card img {
            width: 100%;
            height: 150px;       
            object-fit: cover;   
            border-radius: 6px;  
            border: 1px solid #ccc;
        }

        .quiz-card:hover {
            border-color: brown;
            transform: translateY(-3px);
        }

        .quiz-card h4 {
            margin: 0 0 6px 0;
            font-size: 22px;
            color: brown;
        }

        .quiz-card p {
            margin: 0;
            font-size: 15px;
            color: #555;
        }

        #acts {
            background-color: rgba(0,0,0,0.04);
        }

        .activity-list {
            display: flex;
            flex-direction: column;
            gap: 14px;
            margin-top: 8px;
        }

        .activity-item {
            background: rgba(255,255,255,0.55);
            border-left: 5px solid brown;
            border-radius: 0 10px 10px 0;
            padding: 14px 18px;
            font-family: "Oswald", sans-serif;
            font-size: clamp(14px, 1.6vw, 18px);
            color: #333;
            transition: 0.2s;
        }
        .activity-item img {
            max-width: 400px;    
            width: 100%;
            height: 220px;      
            object-fit: cover;
            border-radius: 6px;
            border: 1px solid #ccc;
        }

        .activity-item:hover {
            background: rgba(255,255,255,0.85);
            transform: translateX(4px);
        }

        .activity-item strong {
            display: block;
            font-size: clamp(16px, 2vw, 20px);
            color: brown;
            margin-bottom: 4px;
        }

        #exams {
            background-color: rgba(0,0,0,0.04);
        }

        .exam-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
            gap: 16px;
            margin-top: 8px;
        }

        .exam-card {
            background: rgba(255,255,255,0.55);
            border: 2px solid gray;
            border-radius: 10px;
            padding: 18px 20px;
            font-family: "Oswald", sans-serif;
            transition: 0.2s;
        }
        .exam-card img {
            width: 100%;
            height: 150px;
            object-fit: cover;
            border-radius: 6px;
            border: 1px solid #ccc;
        }

        .exam-card:hover {
            border-color: brown;
            transform: translateY(-3px);
        }

        .exam-card h4 {
            margin: 0 0 6px 0;
            font-size: 22px;
            color: brown;
        }

        .exam-card p {
            margin: 0;
            font-size: 15px;
            color: #555;
        }

        .dashboard {
            padding: 40px 20px;
        }

        .dashboard-container {
            max-width: 1100px;
            margin: 0 auto;
        }

        .dashboard-title {
            font-family: "Oswald", sans-serif;
            font-weight: bold;
            font-size: clamp(50px, 8vw, 120px);
            color: gray;
            margin: 0 0 20px 0;
            transition: 0.2s;
            cursor: default;
        }

        .dashboard-title:hover {
            color: brown;
            transform: scale(1.02);
        }

        .dashboard-tabs {
            display: flex;
            gap: 10px;
            margin-bottom: 20px;
            flex-wrap: wrap;
        }

        .dashboard-tabs button {
            font-family: "Oswald", sans-serif;
            padding: 12px 24px;
            border-radius: 8px;
            border: 2px solid gray;
            background: transparent;
            cursor: pointer;
            font-size: 18px;
            transition: 0.2s;
        }

        .dashboard-tabs button:hover {
            border-color: brown;
            color: brown;
        }

        .dashboard-tabs button.active {
            background: firebrick;
            color: white;
            border-color: firebrick;
        }

        .dashboard-table {
            width: 100%;
            border-collapse: collapse;
            background: rgba(255,255,255,0.5);
            overflow: hidden;
            border-radius: 10px;
            font-family: "Oswald", sans-serif;
        }

        .dashboard-table th {
            background: firebrick;
            color: white;
            padding: 16px;
            text-align: left;
            font-family: "Oswald", sans-serif;
        }

        .dashboard-table td {
            padding: 16px;
            border-bottom: 1px solid rgba(0,0,0,0.1);
            font-family: "Oswald", sans-serif;
        }

        .dashboard-table tbody tr {
            transition: 0.2s;
        }

        .dashboard-table tbody tr:hover td {
            background: rgba(165, 42, 42, 0.12);
            color: brown;
        }

        .score-pill {
            display: inline-block;
            background: #e9d4cc;
            color: firebrick;
            padding: 5px 14px;
            border-radius: 20px;
            font-weight: bold;
        }

        @media (max-width: 768px) {
            .dashboard-table {
                font-size: 14px;
            }

            .dashboard-table th,
            .dashboard-table td {
                padding: 10px;
            }

            .dashboard-tabs button {
                font-size: 14px;
                padding: 10px 16px;
            }
        }

        footer {
            text-align: center;
            padding: 20px;
            font-family: "Oswald", sans-serif;
            font-size: 14px;
            color: #888;
            background: rgba(0,0,0,0.05);
        }

        hr {
            border: none;
            border-top: 1px solid #ccc;
            margin: 20px 0;
        }

        @media (max-width: 600px) {
            .about-container {
                flex-direction: column;
                align-items: center;
            }

            .logo {
                width: 80%;
                max-width: 300px;
            }

            .paragraph {
                width: 100%;
                text-align: left;
            }

            .top {
                gap: 6px;
                padding: 12px 10px;
            }
        }
        

    </style>
    <title>Student Portfolio — Jyrus Adam Galletes</title>
</head>
